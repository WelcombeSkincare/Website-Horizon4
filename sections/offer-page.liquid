{%- comment -%}
  sections/offer-page.liquid
  Opening Offer page (design handoff "content pages", page 2).

  This is the only conversion page in the set, and the live version it replaces
  had NO call to action at all - no button, no shop link, no next step.

  Its persuasive force is its plainness. Resist decorating it.

  The two dates are schema settings, never hardcoded strings, and they must stay
  in step with the announcement bar (sections/header-group.json). The live site
  once carried a bar and a page describing different offers with different
  names and different dates; that is the failure this guards against.

  Narrower measure than the FAQ: a 1000px content column throughout.
{%- endcomment -%}

{%- assign sw = section.settings.section_width | default: 'normal' -%}

<div class="bd-of page-width-{{ sw }}" data-bd-of>

  {%- comment -%} HERO {%- endcomment -%}
  <div class="bd-of-hero">
    <div class="bd-of-col">
      {%- if section.settings.eyebrow != blank -%}
        <p class="bd-of-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="bd-of-h1">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.offer_line != blank -%}
        <div class="bd-of-standfirst">{{ section.settings.offer_line }}</div>
      {%- endif -%}
      <div class="bd-of-btns">
        {%- if section.settings.primary_button_label != blank -%}
          <a class="bd-of-btn" href="{{ section.settings.primary_button_url }}">{{ section.settings.primary_button_label }}</a>
        {%- endif -%}
        {%- if section.settings.secondary_button_label != blank -%}
          <a class="bd-of-btn bd-of-btn--secondary" href="{{ section.settings.secondary_button_url }}">{{ section.settings.secondary_button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="bd-of-body">
    <div class="bd-of-col">

      {%- comment -%} PREAMBLE {%- endcomment -%}
      {%- if section.settings.preamble != blank -%}
        <div class="bd-of-preamble">{{ section.settings.preamble }}</div>
      {%- endif -%}

      {%- comment -%} HOW IT WORKS - numbered cards {%- endcomment -%}
      {%- assign conditions = section.blocks | where: 'type', 'condition' -%}
      {%- if conditions.size > 0 -%}
        {%- if section.settings.how_heading != blank -%}
          <h2 class="bd-of-h2">{{ section.settings.how_heading }}</h2>
        {%- endif -%}
        <div class="bd-of-conditions">
          {%- for block in conditions -%}
            <div class="bd-of-cond" {{ block.shopify_attributes }}>
              <span class="bd-of-cond-num" aria-hidden="true">{{ forloop.index }}</span>
              <p class="bd-of-cond-title">{{ block.settings.title }}</p>
              {%- if block.settings.body != blank -%}
                <div class="bd-of-cond-body">{{ block.settings.body }}</div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%}
        TIMELINE - the one graphic on the page.
        The dates are the hard part of this offer: qualify by one date, the
        discount runs to another. A plain horizontal line makes it graspable.
      {%- endcomment -%}
      {%- assign milestones = section.blocks | where: 'type', 'milestone' -%}
      {%- if milestones.size > 0 -%}
        <div class="bd-of-timeline">
          {%- if section.settings.timeline_eyebrow != blank -%}
            <p class="bd-of-eyebrow">{{ section.settings.timeline_eyebrow }}</p>
          {%- endif -%}
          <ol class="bd-of-tl-track">
            {%- for block in milestones -%}
              <li class="bd-of-tl-step" {{ block.shopify_attributes }}>
                <span class="bd-of-tl-dot{% if block.settings.style == 'hollow' %} is-hollow{% endif %}" aria-hidden="true"></span>
                <p class="bd-of-tl-date">{{ block.settings.date }}</p>
                <p class="bd-of-tl-cap">{{ block.settings.caption }}</p>
              </li>
            {%- endfor -%}
          </ol>
        </div>
      {%- endif -%}

      {%- comment -%} WHY WE ARE DOING IT {%- endcomment -%}
      {%- if section.settings.why_body != blank -%}
        <div class="bd-of-split">
          <h2 class="bd-of-h2">{{ section.settings.why_heading }}</h2>
          <div class="bd-of-why">{{ section.settings.why_body }}</div>
        </div>
      {%- endif -%}

      {%- comment -%} SMALL PRINT - blocks, because terms change {%- endcomment -%}
      {%- assign terms = section.blocks | where: 'type', 'term' -%}
      {%- if terms.size > 0 -%}
        <div class="bd-of-smallprint">
          {%- if section.settings.smallprint_heading != blank -%}
            <h2 class="bd-of-h2 bd-of-h2--sp">{{ section.settings.smallprint_heading }}</h2>
          {%- endif -%}
          {%- for block in terms -%}
            <div class="bd-of-term" {{ block.shopify_attributes }}>
              <p class="bd-of-term-label">{{ block.settings.label }}</p>
              <div class="bd-of-term-body">{{ block.settings.body }}</div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} CLOSE {%- endcomment -%}
      <div class="bd-of-close">
        <div>
          {%- if section.settings.close_button_label != blank -%}
            <a class="bd-of-btn" href="{{ section.settings.close_button_url }}">{{ section.settings.close_button_label }}</a>
          {%- endif -%}
          {%- if section.settings.close_note != blank -%}
            <p class="bd-of-close-note">{{ section.settings.close_note }}</p>
          {%- endif -%}
        </div>
        <div class="bd-of-close-img">
          {%- if section.settings.close_image != blank -%}
            {{ section.settings.close_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.close_image_alt }}
          {%- else -%}
            <span class="bd-of-img-empty" aria-hidden="true"></span>
          {%- endif -%}
        </div>
      </div>

      {%- if section.settings.legal != blank -%}
        <div class="bd-of-legal">{{ section.settings.legal }}</div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
.bd-of {
  --bd-gutter: 80px;
  --bd-oyster: #E0E1E2;
}
.bd-of-hero,
.bd-of-body { padding-inline: max(var(--bd-gutter), calc((100% - var(--page-content-width, 120rem)) / 2)); }
.bd-of-col { max-width: 1000px; margin-inline: auto; }
.bd-of-hero { background: #FFFFFF; border-bottom: 1px solid var(--bd-oyster); padding-block: 96px 80px; }
.bd-of-body { background: #FAF7F5; padding-block: 80px 96px; }

.bd-of-eyebrow {
  font-family: 'Roboto Condensed', sans-serif;
  font-weight: 700; font-size: 12px; letter-spacing: .12em;
  text-transform: uppercase; color: #57585C; margin: 0 0 18px;
}
.bd-of-h1 {
  font-family: 'Roboto Condensed', sans-serif; font-weight: 400;
  font-size: 72px; line-height: 1.04; color: #161617; max-width: 14ch; margin: 0 0 24px;
}
.bd-of-standfirst {
  font-family: 'Roboto Condensed', sans-serif; font-weight: 400;
  font-size: 28px; line-height: 1.3; color: #3F4042; max-width: 40ch;
}
.bd-of-standfirst p { margin: 0; }
.bd-of-btns { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 34px; }

.bd-of-h2 {
  font-family: 'Roboto Condensed', sans-serif; font-weight: 400;
  font-size: 40px; line-height: 1.1; color: #3F4042; margin: 0 0 24px;
}
.bd-of-preamble { font-size: 21px; line-height: 1.55; color: #414245; max-width: 60ch; margin-bottom: 72px; }
.bd-of-preamble p { margin: 0 0 20px; }
.bd-of-preamble p:last-child { margin-bottom: 0; }

/* --- numbered cards --- */
.bd-of-conditions { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 72px; }
.bd-of-cond {
  background: #FFFFFF; border: 1px solid var(--bd-oyster); border-radius: 4px;
  padding: 32px 30px 34px; position: relative; overflow: hidden;
}
.bd-of-cond-num {
  position: absolute; right: 14px; top: -18px; pointer-events: none;
  font-family: 'Roboto Condensed', sans-serif; font-weight: 700;
  font-size: 112px; line-height: 1; color: var(--bd-oyster);
}
.bd-of-cond-title {
  position: relative;
  font-family: 'Roboto Condensed', sans-serif; font-size: 24px; line-height: 1.25;
  color: #3F4042; max-width: 15ch; margin: 0 0 12px;
}
.bd-of-cond-body { position: relative; }
.bd-of-cond-body p { font-size: 16px; line-height: 1.6; color: #494A4D; margin: 0; }

/* --- timeline --- */
.bd-of-timeline { background: #FFFFFF; border: 1px solid var(--bd-oyster); border-radius: 4px; padding: 40px 44px 36px; margin-bottom: 72px; }
.bd-of-tl-track {
  list-style: none; margin: 0; padding: 0;
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; position: relative;
}
.bd-of-tl-track::before {
  content: ''; position: absolute; top: 5px; left: 6px; right: 6px;
  height: 1px; background: var(--bd-oyster);
}
.bd-of-tl-step { position: relative; }
.bd-of-tl-dot { display: block; width: 11px; height: 11px; border-radius: 50%; background: #161617; margin-bottom: 18px; }
.bd-of-tl-dot.is-hollow { background: #FFFFFF; border: 2px solid #57585C; }
.bd-of-tl-date { font-family: 'Roboto Condensed', sans-serif; font-size: 22px; color: #3F4042; margin: 0 0 6px; }
.bd-of-tl-cap { font-size: 15px; line-height: 1.55; color: #57585C; margin: 0; }

/* --- why --- */
.bd-of-split { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 56px; margin-bottom: 72px; align-items: start; }
.bd-of-why p { font-size: 18px; line-height: 1.65; color: #494A4D; margin: 0 0 18px; }
.bd-of-why p:last-child { margin-bottom: 0; }

/* --- small print --- */
.bd-of-smallprint { background: #FBFBF2; border: 1px solid var(--bd-oyster); border-radius: 4px; padding: 44px 48px; margin-bottom: 72px; }
.bd-of-h2--sp { font-size: 32px; }
.bd-of-term { display: grid; grid-template-columns: 190px minmax(0, 1fr); gap: 28px; padding: 18px 0; border-top: 1px solid var(--bd-oyster); }
.bd-of-term:last-child { border-bottom: 1px solid var(--bd-oyster); }
.bd-of-term-label {
  font-family: 'Roboto Condensed', sans-serif; font-weight: 700;
  font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: #57585C; margin: 0;
}
.bd-of-term-body p { font-size: 16px; line-height: 1.6; color: #494A4D; margin: 0; max-width: 58ch; }
.bd-of-term-body a { color: #161617; text-decoration: underline; }

/* --- close --- */
.bd-of-close { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 40px; align-items: center; }
.bd-of-close-note { font-size: 16px; color: #57585C; margin: 14px 0 0; }
.bd-of-close-img { aspect-ratio: 4 / 3; background: #FFFFFF; border: 1px solid var(--bd-oyster); border-radius: 4px; overflow: hidden; }
.bd-of-close-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
.bd-of-img-empty { display: block; width: 100%; height: 100%; }
.bd-of-legal { margin-top: 40px; }
.bd-of-legal p { font-size: 13px; line-height: 1.6; color: #57585C; margin: 0; }

.bd-of-btn {
  display: inline-block;
  font-family: 'Roboto Condensed', sans-serif; font-weight: 700; font-size: 16px;
  background: #161617; color: #FFFFFF; border: 2px solid #161617; border-radius: 14px;
  padding: 14px 28px; text-decoration: none; white-space: nowrap;
  transition: background-color .16s ease, border-color .16s ease;
}
.bd-of-btn:hover { background: #3F4042; border-color: #3F4042; }
.bd-of-btn--secondary { background: transparent; color: #161617; }
.bd-of-btn--secondary:hover { background: #0000000f; border-color: #161617; }

@media (max-width: 749px) {
  .bd-of { --bd-gutter: 20px; }
  .bd-of-hero { padding-block: 48px 40px; }
  .bd-of-body { padding-block: 44px 56px; }
  .bd-of-h1 { font-size: 40px; }
  .bd-of-standfirst { font-size: 21px; }
  .bd-of-h2 { font-size: 30px; }
  .bd-of-preamble { font-size: 17px; }
  .bd-of-split { grid-template-columns: 1fr; gap: 20px; }
  .bd-of-smallprint { padding: 28px 22px; }
  .bd-of-term { grid-template-columns: 1fr; gap: 8px; }
  /* timeline becomes vertical: the rule moves to a left-hand line */
  .bd-of-tl-track { grid-template-columns: 1fr; gap: 26px; padding-left: 22px; }
  .bd-of-tl-track::before { top: 6px; bottom: 6px; left: 5px; right: auto; width: 1px; height: auto; }
  .bd-of-tl-dot { position: absolute; left: -22px; top: 6px; margin: 0; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Opening Offer page",
  "tag": "section",
  "class": "shopify-section--bd-offer",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "narrow", "label": "Narrow" },
        { "value": "normal", "label": "Normal" },
        { "value": "wide", "label": "Wide" },
        { "value": "content", "label": "Content width" }
      ],
      "default": "normal"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Founding customers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening Offer" },
    { "type": "richtext", "id": "offer_line", "label": "Offer line" },
    { "type": "text", "id": "primary_button_label", "label": "Primary button label", "default": "Shop the range" },
    { "type": "url", "id": "primary_button_url", "label": "Primary button link" },
    { "type": "text", "id": "secondary_button_label", "label": "Secondary button label", "default": "Find your skin type" },
    { "type": "url", "id": "secondary_button_url", "label": "Secondary button link" },
    { "type": "richtext", "id": "preamble", "label": "Preamble" },
    { "type": "text", "id": "how_heading", "label": "How it works heading", "default": "How it works" },
    { "type": "text", "id": "timeline_eyebrow", "label": "Timeline eyebrow", "default": "The dates, on one line" },
    { "type": "text", "id": "why_heading", "label": "Why heading", "default": "Why we are doing it" },
    { "type": "richtext", "id": "why_body", "label": "Why body" },
    { "type": "text", "id": "smallprint_heading", "label": "Small print heading", "default": "The small print, in plain English" },
    { "type": "header", "content": "Close" },
    { "type": "text", "id": "close_button_label", "label": "Button label", "default": "Shop the range" },
    { "type": "url", "id": "close_button_url", "label": "Button link" },
    { "type": "text", "id": "close_note", "label": "Note beside the button", "default": "The discount comes off at checkout." },
    { "type": "image_picker", "id": "close_image", "label": "Product image" },
    { "type": "text", "id": "close_image_alt", "label": "Product image alt text" },
    { "type": "richtext", "id": "legal", "label": "Legal line" }
  ],
  "blocks": [
    {
      "type": "condition",
      "name": "Numbered card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "body", "label": "Body" }
      ]
    },
    {
      "type": "milestone",
      "name": "Timeline milestone",
      "settings": [
        { "type": "text", "id": "date", "label": "Date" },
        { "type": "textarea", "id": "caption", "label": "Caption" },
        {
          "type": "select",
          "id": "style",
          "label": "Dot style",
          "info": "Hollow marks an end point rather than a milestone reached.",
          "options": [
            { "value": "filled", "label": "Filled" },
            { "value": "hollow", "label": "Hollow" }
          ],
          "default": "filled"
        }
      ]
    },
    {
      "type": "term",
      "name": "Small print row",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "richtext", "id": "body", "label": "Body" }
      ]
    }
  ],
  "presets": [{ "name": "Opening Offer page" }]
}
{% endschema %}
