{%- comment -%}
  sections/contact-channels.liquid
  /pages/contact (design handoff "content pages", page 3).

  This section adds AROUND the form, it does not replace it. page.contact.json
  keeps its `section` with the contact-form and contact-form-submit-button
  blocks, which post to Shopify's real {% form 'contact' %} endpoint with the
  right field names and error handling. The prototype's <input> elements are
  visual reference only and post nowhere.

  Two channel cards sit ABOVE everything else, because the copy says the phone
  is better when something is urgent and the old layout said that nowhere. Each
  card is a single <a> - mailto: or tel: - so the whole card is the hit target,
  comfortably above the 44px minimum.

  TRIAL vs RETURNS - these are different things and the copy must not merge them:
    - the Two-Week Trial is a USAGE RECOMMENDATION, give it a fortnight before
      judging it. It is NOT a returns assurance and must never be written as one.
    - the assurance is the 14-day statutory right to cancel, plus an extended
      60-day return period. The 60 days INCLUDES the 14, it is not 60 + 14.
  The live page previously said "the 60-day trial and the 14-day statutory right
  to cancel", which got both halves wrong.
{%- endcomment -%}

{%- assign sw = section.settings.section_width | default: 'normal' -%}

<div class="bd-cc page-width-{{ sw }}" data-bd-cc>

  {%- comment -%} CHANNEL CARDS - above everything else {%- endcomment -%}
  {%- assign channels = section.blocks | where: 'type', 'channel' -%}
  {%- if channels.size > 0 -%}
    <div class="bd-cc-channels">
      {%- for block in channels -%}
        <a class="bd-cc-channel" href="{{ block.settings.href }}" {{ block.shopify_attributes }}>
          <span class="bd-cc-channel-label">{{ block.settings.label }}</span>
          <span class="bd-cc-channel-value">{{ block.settings.value }}</span>
          {%- if block.settings.note != blank -%}
            <span class="bd-cc-channel-note">{{ block.settings.note }}</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- comment -%} NOTES SIDEBAR {%- endcomment -%}
  {%- assign notes = section.blocks | where: 'type', 'note' -%}
  {%- if notes.size > 0 -%}
    <aside class="bd-cc-notes">
      {%- for block in notes -%}
        <div class="bd-cc-note" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h3 class="bd-cc-note-h">{{ block.settings.heading }}</h3>
          {%- endif -%}
          <div class="bd-cc-note-b">{{ block.settings.body }}</div>
        </div>
      {%- endfor -%}
    </aside>
  {%- endif -%}

  {%- comment -%} REGISTERED ADDRESS + LOCATOR {%- endcomment -%}
  {%- if section.settings.legal != blank or section.settings.map_image != blank -%}
    <div class="bd-cc-foot">
      {%- if section.settings.legal != blank -%}
        <div class="bd-cc-legal">{{ section.settings.legal }}</div>
      {%- endif -%}
      {%- comment -%}
        A static image, not Leaflet. Pulling a mapping library into the theme for
        one decorative locator is a poor performance trade, and the address above
        is the text alternative - hence the empty alt when none is given.
      {%- endcomment -%}
      {%- if section.settings.map_image != blank -%}
        <div class="bd-cc-map">
          {{ section.settings.map_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.map_alt }}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
.bd-cc {
  --bd-gutter: 80px;
  --bd-oyster: #E0E1E2;
  padding-inline: max(var(--bd-gutter), calc((100% - var(--page-content-width, 120rem)) / 2));
  padding-block: 8px 72px;
  background: #FAF7F5;
}
.bd-cc-channels { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }
.bd-cc-channel {
  display: block; background: #FFFFFF; border: 1px solid var(--bd-oyster);
  border-radius: 4px; padding: 36px 38px; text-decoration: none;
  transition: border-color .16s ease;
}
.bd-cc-channel:hover { border-color: #57585C; }
.bd-cc-channel-label {
  display: block; font-family: 'Roboto Condensed', sans-serif; font-weight: 700;
  font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: #57585C;
  margin-bottom: 10px;
}
.bd-cc-channel-value {
  display: block; font-family: 'Roboto Condensed', sans-serif; font-weight: 400;
  font-size: 34px; line-height: 1.15; color: #161617; word-break: break-word;
  margin-bottom: 12px;
}
.bd-cc-channel-note { display: block; font-size: 16px; line-height: 1.55; color: #494A4D; }

.bd-cc-notes { display: flex; flex-direction: column; gap: 36px; margin-top: 56px; max-width: 400px; }
.bd-cc-note + .bd-cc-note { border-top: 1px solid var(--bd-oyster); padding-top: 30px; }
.bd-cc-note-h { font-family: 'Roboto Condensed', sans-serif; font-weight: 400; font-size: 24px; color: #414245; margin: 0 0 10px; }
.bd-cc-note-b p { font-size: 16px; line-height: 1.6; color: #494A4D; margin: 0 0 10px; }
.bd-cc-note-b p:last-child { margin-bottom: 0; }
.bd-cc-note-b a { color: #161617; text-decoration: underline; }

.bd-cc-foot {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 40px; align-items: center; margin-top: 64px;
  border-top: 1px solid var(--bd-oyster); padding-top: 40px;
}
.bd-cc-legal p { font-size: 15px; line-height: 1.6; color: #57585C; margin: 0 0 8px; }
.bd-cc-legal p:last-child { margin-bottom: 0; }
.bd-cc-map { aspect-ratio: 4 / 3; border: 1px solid var(--bd-oyster); border-radius: 4px; overflow: hidden; background: #FFFFFF; }
.bd-cc-map img { width: 100%; height: 100%; object-fit: cover; display: block; }

@media (max-width: 749px) {
  .bd-cc { --bd-gutter: 20px; padding-block: 8px 48px; }
  .bd-cc-channel { padding: 26px 22px; }
  .bd-cc-channel-value { font-size: 26px; }
  .bd-cc-notes { max-width: none; margin-top: 40px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Contact channels",
  "tag": "section",
  "class": "shopify-section--bd-contact",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "narrow", "label": "Narrow" },
        { "value": "normal", "label": "Normal" },
        { "value": "wide", "label": "Wide" },
        { "value": "content", "label": "Content width" }
      ],
      "default": "normal"
    },
    { "type": "richtext", "id": "legal", "label": "Registered address" },
    { "type": "image_picker", "id": "map_image", "label": "Locator image", "info": "A static map or a committed SVG. Do not pull in a mapping library for one decorative locator." },
    { "type": "text", "id": "map_alt", "label": "Locator alt text", "info": "Leave blank if the address above already says it - the image is then decorative." }
  ],
  "blocks": [
    {
      "type": "channel",
      "name": "Channel card",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "value", "label": "Value" },
        { "type": "text", "id": "href", "label": "Link", "info": "mailto: or tel:" },
        { "type": "textarea", "id": "note", "label": "Note" }
      ]
    },
    {
      "type": "note",
      "name": "Note",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "body", "label": "Body" }
      ]
    }
  ],
  "presets": [{ "name": "Contact channels" }]
}
{% endschema %}
