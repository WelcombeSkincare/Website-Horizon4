{%- comment -%}
  sections/journal-index.liquid
  The Journal browsing surface: lead post, then a card grid, with client-side
  category filtering. Assigned via templates/blog.journal.json.

  Design ref: "Journal blog layout drafts" project, option 1c.

  DATA MODEL
  Each article may point at a `journal_post_meta` metaobject via
  `article.metafields.custom.journal_post_meta`. This section reads:
    - article.title          -> card title
    - mf.category            -> filter chip + card eyebrow
    - mf.standfirst          -> card body (HTML stripped, truncated)
    - mf.reading_time        -> card meta
    - mf.byline              -> card meta
    - mf.photo               -> card image (falls back to article.image)
  Chips are built from the categories actually present, so a new category
  appears without a code change. Posts with no category filter under "All".
{%- endcomment -%}

{%- liquid
  assign the_blog = section.settings.blog | default: blog
  assign posts = the_blog.articles
-%}

{%- capture category_list -%}
  {%- for post in posts -%}
    {%- assign pmf = post.metafields.custom.journal_post_meta.value -%}
    {%- if pmf.category != blank -%}{{ pmf.category }}|{%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign categories = category_list | strip | split: '|' | uniq -%}

<div class="bd-jx" data-jx>

  <div class="bd-jx-head">
    {%- if section.settings.eyebrow != blank -%}
      <p class="bd-jx-eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="bd-jx-h1">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <p class="bd-jx-intro">{{ section.settings.intro }}</p>
    {%- endif -%}

    {%- if section.settings.show_filters and categories.size > 1 -%}
      <div class="bd-jx-chips">
        <button type="button" class="bd-jx-chip is-on" data-jx-chip="" aria-pressed="true">All posts</button>
        {%- for category in categories -%}
          <button type="button" class="bd-jx-chip" data-jx-chip="{{ category | downcase | escape }}" aria-pressed="false">{{ category }}</button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="bd-jx-empty" data-jx-empty>No posts in this category yet.</div>

  {%- for post in posts -%}
    {%- liquid
      assign pmf = post.metafields.custom.journal_post_meta.value
      assign pimg = pmf.photo | default: post.image
      assign stand = pmf.standfirst | strip_html | strip
      assign cat_key = pmf.category | downcase
    -%}

    {%- if forloop.first and section.settings.lead_post -%}
      <a class="bd-jx-lead" data-jx-card data-category="{{ cat_key | escape }}" href="{{ post.url }}">
        {%- if pimg != blank -%}
          {{ pimg | image_url: width: 1200 | image_tag:
            alt: pmf.photo_caption | default: post.title,
            loading: 'eager',
            widths: '600, 900, 1200',
            sizes: '(max-width: 749px) 100vw, 640px' }}
        {%- else -%}
          <span class="bd-jx-noimg"></span>
        {%- endif -%}
        <span class="bd-jx-lead-body">
          {%- if pmf.category != blank -%}<span class="bd-jx-cat">{{ pmf.category }}</span>{%- endif -%}
          <span class="bd-jx-lead-t">{{ post.title }}</span>
          {%- if stand != blank -%}<span class="bd-jx-lead-s">{{ stand | truncate: 220 }}</span>{%- endif -%}
          <span class="bd-jx-meta">
            {%- if pmf.byline != blank -%}{{ pmf.byline }} &middot; {% endif -%}
            {{ post.published_at | date: '%-d %B %Y' }}
            {%- if pmf.reading_time != blank %} &middot; {{ pmf.reading_time }} minute read{% endif -%}
          </span>
        </span>
      </a>
      <div class="bd-jx-grid" data-jx-grid>
    {%- else -%}
      {%- unless section.settings.lead_post -%}
        {%- if forloop.first -%}<div class="bd-jx-grid" data-jx-grid>{%- endif -%}
      {%- endunless -%}
      <a class="bd-jx-card" data-jx-card data-category="{{ cat_key | escape }}" href="{{ post.url }}">
        {%- if pimg != blank -%}
          {{ pimg | image_url: width: 800 | image_tag:
            alt: pmf.photo_caption | default: post.title,
            loading: 'lazy',
            widths: '400, 600, 800',
            sizes: '(max-width: 749px) 100vw, (max-width: 1100px) 45vw, 520px' }}
        {%- else -%}
          <span class="bd-jx-noimg"></span>
        {%- endif -%}
        <span class="bd-jx-card-body">
          {%- if pmf.category != blank -%}<span class="bd-jx-cat">{{ pmf.category }}</span>{%- endif -%}
          <span class="bd-jx-card-t">{{ post.title }}</span>
          {%- if stand != blank -%}<span class="bd-jx-card-s">{{ stand | truncate: 180 }}</span>{%- endif -%}
          <span class="bd-jx-meta">
            {%- if pmf.byline != blank -%}{{ pmf.byline }} &middot; {% endif -%}
            {{ post.published_at | date: '%-d %B %Y' }}
            {%- if pmf.reading_time != blank %} &middot; {{ pmf.reading_time }} minute read{% endif -%}
          </span>
        </span>
      </a>
    {%- endif -%}
    {%- if forloop.last and posts.size > 0 -%}</div>{%- endif -%}
  {%- endfor -%}

</div>

<script>
  (function () {
    var root = document.querySelector('#shopify-section-{{ section.id }} [data-jx]');
    if (!root) return;
    var chips = root.querySelectorAll('[data-jx-chip]');
    if (!chips.length) return;
    var cards = root.querySelectorAll('[data-jx-card]');
    var empty = root.querySelector('[data-jx-empty]');

    Array.prototype.forEach.call(chips, function (chip) {
      chip.addEventListener('click', function () {
        var want = chip.getAttribute('data-jx-chip') || '';
        var shown = 0;
        Array.prototype.forEach.call(chips, function (c) {
          var on = c === chip;
          c.classList.toggle('is-on', on);
          c.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        Array.prototype.forEach.call(cards, function (card) {
          var hit = !want || (card.getAttribute('data-category') || '') === want;
          card.style.display = hit ? '' : 'none';
          if (hit) shown++;
        });
        if (empty) empty.style.display = shown ? 'none' : 'block';
      });
    });
  })();
</script>

{% stylesheet %}
.bd-jx {
  --jx-ink: #161617;
  --jx-body: #4B4C4F;
  --jx-soft: #57585C;
  --jx-mute: #8A8177;
  --jx-line: #ECE7E2;
  --jx-card-line: #E6E1DB;
  --jx-tide: #3D6A75;
  --jx-head: 'Roboto Condensed', Arial, sans-serif;
  --jx-text: var(--font-body--family, 'Poppins', system-ui, sans-serif);
  max-width: 1280px; margin: 0 auto; padding: 72px 80px 96px;
  color: var(--jx-ink); font-family: var(--jx-text);
}
.bd-jx *, .bd-jx *::before, .bd-jx *::after { box-sizing: border-box; }
.bd-jx a { text-decoration: none; color: inherit; }

.bd-jx-eyebrow {
  font-family: var(--jx-head); font-weight: 700; font-size: 13px; line-height: 1;
  letter-spacing: .2em; text-transform: uppercase; color: var(--jx-tide); margin: 0 0 18px;
}
.bd-jx-h1 {
  font-family: var(--jx-head); font-weight: 400; font-size: 54px; line-height: 1.02;
  letter-spacing: -.01em; margin: 0 0 22px; max-width: 16ch; text-wrap: pretty;
}
.bd-jx-intro { font-size: 17px; line-height: 1.62; color: var(--jx-body); margin: 0 0 36px; max-width: 60ch; }
.bd-jx-chips { display: flex; flex-wrap: wrap; gap: 8px; padding-bottom: 36px; border-bottom: 1px solid var(--jx-line); }
.bd-jx-chip {
  font-family: var(--jx-head); font-weight: 700; font-size: 12px; line-height: 1;
  letter-spacing: .1em; text-transform: uppercase; color: var(--jx-tide);
  background: #EDF2F2; border: 0; border-radius: 100px; padding: 10px 14px; cursor: pointer;
  transition: background 180ms ease, color 180ms ease;
}
.bd-jx-chip:hover { background: #E2EAEA; }
.bd-jx-chip.is-on { background: var(--jx-ink); color: #fff; }

.bd-jx-empty { display: none; padding: 64px 0; text-align: center; font-size: 16px; color: var(--jx-mute); }

.bd-jx-lead {
  display: grid; grid-template-columns: 1.6fr 1fr; gap: 44px; align-items: center;
  padding: 44px 0; border-bottom: 1px solid var(--jx-line);
}
.bd-jx-lead img, .bd-jx-noimg { width: 100%; height: 420px; object-fit: cover; display: block; background: #F0EDEA; }
.bd-jx-lead-body { display: flex; flex-direction: column; }
.bd-jx-lead-t { font-family: var(--jx-head); font-size: 36px; line-height: 1.08; margin: 14px 0 16px; }
.bd-jx-lead-s { font-size: 16px; line-height: 1.65; color: var(--jx-soft); margin: 0 0 20px; }
.bd-jx-lead:hover .bd-jx-lead-t { color: var(--jx-tide); }

.bd-jx-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; padding-top: 44px; }
.bd-jx-card {
  display: flex; flex-direction: column; background: #fff;
  border: 1px solid var(--jx-card-line); border-radius: 4px; overflow: hidden;
  transition: border-color 180ms ease, transform 180ms ease;
}
.bd-jx-card:hover { border-color: #B9C7C2; transform: translateY(-2px); }
.bd-jx-card img, .bd-jx-card .bd-jx-noimg { width: 100%; height: 260px; object-fit: cover; display: block; background: #F0EDEA; }
.bd-jx-card-body { padding: 22px 24px 26px; display: flex; flex-direction: column; }
.bd-jx-card-t { font-family: var(--jx-head); font-size: 26px; line-height: 1.12; margin: 12px 0; }
.bd-jx-card-s { font-size: 15px; line-height: 1.6; color: var(--jx-soft); margin: 0 0 16px; }

.bd-jx-cat {
  font-family: var(--jx-head); font-weight: 700; font-size: 11px; line-height: 1;
  letter-spacing: .12em; text-transform: uppercase; color: var(--jx-tide);
}
.bd-jx-meta { font-size: 13px; line-height: 1.4; color: var(--jx-mute); margin-top: auto; }

@media screen and (max-width: 1100px) {
  .bd-jx { padding-left: 40px; padding-right: 40px; }
  .bd-jx-lead { grid-template-columns: 1fr; gap: 24px; }
  .bd-jx-lead img, .bd-jx-noimg { height: 320px; }
}
@media screen and (max-width: 749px) {
  .bd-jx { padding: 32px 20px 56px; }
  .bd-jx-h1 { font-size: 36px; max-width: none; }
  .bd-jx-intro { font-size: 16px; }
  .bd-jx-chips { gap: 6px; padding-bottom: 24px; overflow-x: auto; flex-wrap: nowrap; scrollbar-width: none; }
  .bd-jx-chips::-webkit-scrollbar { display: none; }
  .bd-jx-chip { flex: none; font-size: 11px; padding: 8px 12px; }
  .bd-jx-lead { padding: 28px 0; }
  .bd-jx-lead img, .bd-jx-noimg { height: 240px; }
  .bd-jx-lead-t { font-size: 28px; margin: 12px 0 12px; }
  .bd-jx-grid { grid-template-columns: 1fr; gap: 20px; padding-top: 28px; }
  .bd-jx-card img, .bd-jx-card .bd-jx-noimg { height: 200px; }
  .bd-jx-card-body { padding: 18px 20px 22px; }
  .bd-jx-card-t { font-size: 23px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Journal index",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Journal blog",
      "info": "Leave empty on a blog template to use the blog being viewed."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Journal" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Skin, ingredients and the evidence behind them"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro paragraph",
      "default": "Explainers written to be useful whether or not you buy anything. We review the published research, and where the evidence stops we say so."
    },
    { "type": "header", "content": "Layout" },
    {
      "type": "checkbox",
      "id": "lead_post",
      "label": "Show the newest post as a lead",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show category filters",
      "default": true,
      "info": "Hidden automatically when only one category is in use."
    }
  ],
  "presets": [{ "name": "Journal index" }]
}
{% endschema %}
