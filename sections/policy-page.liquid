{%- comment -%}
  sections/policy-page.liquid
  Legal / policy page (design handoff "content pages", page 6).

  Deliberately GENERIC: heading, "last updated" pill, a sticky contents rail and
  a stack of sections. It is used by the cookie policy and can serve any other
  legal page that lives as a real Shopify PAGE.

  It cannot serve /policies/* (privacy, refund, shipping, terms). Those are
  admin-managed records rendered straight into the layout with no content
  section at all - verified 2026-08-11, all four return only header, footer and
  cart-drawer sections. Moving that text into the theme would take it out of
  Shopify's policy versioning, so it is deliberately not attempted here.

  Nobody reads a legal page top to bottom; they arrive looking for one clause.
  Hence the rail, the anchors and the scroll-margin.

  The cookie TABLES are the main fix. A four-column table breaks on a phone, so
  each row is an auto-fitting labelled group instead: every cell carries its own
  micro-label above its value, so the row still reads as a labelled record when
  it stacks. No sideways scrolling, no lost header row.

  Blocks are FLAT and ordered, as in faq-page.liquid: a `table_group` opens a
  group and every `table_row` after it belongs to that group.

  Deliberately no imagery. A legal page does not get decorated.
{%- endcomment -%}

{%- assign sw = section.settings.section_width | default: 'normal' -%}

<div class="bd-pol page-width-{{ sw }}" data-bd-pol>

  {%- comment -%} HEADER BAND {%- endcomment -%}
  <div class="bd-pol-head">
    {%- if section.settings.eyebrow != blank -%}
      <p class="bd-pol-eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="bd-pol-h1">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.last_updated != blank -%}
      <p class="bd-pol-pill">{{ section.settings.last_updated }}</p>
    {%- endif -%}
  </div>

  <div class="bd-pol-body">

    {%- comment -%} CONTENTS RAIL {%- endcomment -%}
    <aside class="bd-pol-rail">
      <details class="bd-pol-rail-wrap" open>
        <summary class="bd-pol-rail-label">{{ section.settings.contents_label | default: 'Contents' }}</summary>
        <nav class="bd-pol-rail-list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'section' and block.settings.heading != blank -%}
              <a class="bd-pol-rail-row" href="#{{ block.settings.heading | handleize }}">{{ block.settings.heading }}</a>
            {%- endif -%}
          {%- endfor -%}
        </nav>
        {%- if section.settings.settings_button_label != blank -%}
          {%- comment -%}
            The copy promises a way to change your choice, so this must really
            open the consent manager or not exist at all.

            Pandectes (verified 2026-08-11) exposes NO public open-preferences
            function: PandectesCore carries only PandectesWebComponent and
            PandectesRules only initialize. Its floating "reopen" widget is
            enabled but lives inside a shadow root, so it cannot be clicked
            from here reliably.

            The supported route is to switch ON "custom trigger" in the
            Pandectes app admin, nominate a selector, and paste that selector
            into the setting below. Until that is done the button hides itself
            rather than presenting a dead control - the floating widget at
            bottom left still lets a visitor change their consent.
          {%- endcomment -%}
          <button
            type="button"
            class="bd-pol-settings"
            data-bd-pol-consent
            data-trigger="{{ section.settings.settings_trigger_selector | escape }}"
            hidden
          >
            {{ section.settings.settings_button_label }}
          </button>
        {%- endif -%}
      </details>
    </aside>

    {%- comment -%} CONTENT {%- endcomment -%}
    <div class="bd-pol-main">
      {%- for block in section.blocks -%}

        {%- case block.type -%}

          {%- when 'section' -%}
            {%- unless forloop.first -%}{%- endunless -%}
            <section class="bd-pol-sec" id="{{ block.settings.heading | handleize }}" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="bd-pol-h2">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.body != blank -%}
                <div class="bd-pol-prose">{{ block.settings.body }}</div>
              {%- endif -%}
              {%- if block.settings.aside != blank -%}
                <div class="bd-pol-aside">{{ block.settings.aside }}</div>
              {%- endif -%}
            </section>

          {%- when 'kind_card' -%}
            {%- assign prev = forloop.index0 | minus: 1 -%}
            {%- unless section.blocks[prev].type == 'kind_card' -%}<div class="bd-pol-kinds">{%- endunless -%}
              <div class="bd-pol-kind" {{ block.shopify_attributes }}>
                <p class="bd-pol-kind-title">{{ block.settings.title }}</p>
                <p class="bd-pol-kind-status">{{ block.settings.status }}</p>
                <p class="bd-pol-kind-body">{{ block.settings.body }}</p>
              </div>
            {%- assign nxt = forloop.index -%}
            {%- unless section.blocks[nxt].type == 'kind_card' -%}</div>{%- endunless -%}

          {%- when 'table_group' -%}
            <p class="bd-pol-tg">{{ block.settings.label }}</p>

          {%- when 'table_row' -%}
            <div class="bd-pol-row" {{ block.shopify_attributes }}>
              <div class="bd-pol-cell">
                <span class="bd-pol-micro">{{ section.settings.label_cookie | default: 'Cookie' }}</span>
                <span class="bd-pol-val">{{ block.settings.cookie }}</span>
              </div>
              <div class="bd-pol-cell">
                <span class="bd-pol-micro">{{ section.settings.label_set_by | default: 'Set by' }}</span>
                <span class="bd-pol-val">{{ block.settings.set_by }}</span>
              </div>
              <div class="bd-pol-cell bd-pol-cell--wide">
                <span class="bd-pol-micro">{{ section.settings.label_purpose | default: 'Purpose' }}</span>
                <span class="bd-pol-val">{{ block.settings.purpose }}</span>
              </div>
              <div class="bd-pol-cell">
                <span class="bd-pol-micro">{{ section.settings.label_lasts | default: 'Lasts' }}</span>
                <span class="bd-pol-val">{{ block.settings.lasts }}</span>
              </div>
            </div>

          {%- when 'questions_card' -%}
            <div class="bd-pol-qcard" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="bd-pol-h2 bd-pol-h2--card">{{ block.settings.heading }}</h2>
              {%- endif -%}
              <div class="bd-pol-prose">{{ block.settings.body }}</div>
            </div>

        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (() => {
    const btn = document.querySelector('[data-bd-pol-consent]');
    if (!btn) return;
    const sel = (btn.dataset.trigger || '').trim();
    if (!sel) return;  // no custom trigger configured yet - stay hidden

    // Reveal only once the configured trigger actually exists, so the control
    // can never sit there doing nothing.
    const find = () => document.querySelector(sel);
    const reveal = () => { if (find()) { btn.hidden = false; return true; } return false; };
    if (!reveal()) {
      let tries = 0;
      const t = setInterval(() => { if (reveal() || ++tries > 20) clearInterval(t); }, 250);
    }
    btn.addEventListener('click', () => { const el = find(); if (el) el.click(); });
  })();
</script>

{% stylesheet %}
.bd-pol {
  --bd-gutter: 80px;
  --bd-oyster: #E0E1E2;
}
.bd-pol-head,
.bd-pol-body { padding-inline: max(var(--bd-gutter), calc((100% - var(--page-content-width, 120rem)) / 2)); }
.bd-pol-head { background: #FFFFFF; border-bottom: 1px solid var(--bd-oyster); padding-block: 76px 56px; }
.bd-pol-eyebrow {
  font-family: 'Roboto Condensed', sans-serif; font-weight: 700;
  font-size: 12px; letter-spacing: .12em; text-transform: uppercase;
  color: #57585C; margin: 0 0 18px;
}
.bd-pol-h1 {
  font-family: 'Roboto Condensed', sans-serif; font-weight: 400;
  font-size: 52px; line-height: 1.08; color: #161617; margin: 0 0 20px;
}
.bd-pol-pill {
  display: inline-block; margin: 0;
  font-size: 13px; color: #57585C;
  border: 1px solid var(--bd-oyster); border-radius: 999px; padding: 5px 14px;
}

.bd-pol-body {
  background: #FAF7F5; padding-block: 64px 96px;
  display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 72px; align-items: start;
}

/* --- contents rail --- */
.bd-pol-rail { position: sticky; top: 108px; }
.bd-pol-rail-wrap > summary { list-style: none; }
.bd-pol-rail-wrap > summary::-webkit-details-marker { display: none; }
.bd-pol-rail-label {
  font-family: 'Roboto Condensed', sans-serif; font-weight: 700;
  font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: #57585C;
  border-bottom: 1px solid var(--bd-oyster); padding-bottom: 12px; cursor: default;
}
.bd-pol-rail-list { display: block; padding-top: 4px; }
.bd-pol-rail-row { display: block; padding: 8px 0; font-size: 15px; color: #4B4C4F; text-decoration: none; }
.bd-pol-rail-row:hover { color: #161617; text-decoration: underline; }
.bd-pol-settings {
  display: block; width: 100%; text-align: left;
  margin-top: 4px; padding-top: 16px;
  border: 0; border-top: 1px solid var(--bd-oyster); background: none;
  font: inherit; font-size: 14px; color: #57585C; text-decoration: underline; cursor: pointer;
}
.bd-pol-settings:hover { color: #161617; }

/* --- content --- */
.bd-pol-main { max-width: 72ch; }
.bd-pol-sec { scroll-margin-top: 120px; }
.bd-pol-sec + .bd-pol-sec { margin-top: 52px; }
.bd-pol-h2 {
  font-family: 'Roboto Condensed', sans-serif; font-weight: 400;
  font-size: 30px; line-height: 1.1; color: #3F4042; margin: 0 0 14px;
}
.bd-pol-prose p { font-size: 17px; line-height: 1.65; color: #494A4D; margin: 0 0 14px; }
.bd-pol-prose p:last-child { margin-bottom: 0; }
.bd-pol-prose a { color: #161617; text-decoration: underline; }
.bd-pol-prose ul, .bd-pol-prose ol { margin: 0 0 14px; padding-left: 20px; }
.bd-pol-prose li { font-size: 17px; line-height: 1.65; color: #494A4D; margin-bottom: 6px; }
.bd-pol-aside {
  border-left: 2px solid var(--bd-oyster); padding-left: 18px; margin-top: 18px;
}
.bd-pol-aside p { font-size: 15px; line-height: 1.6; color: #57585C; margin: 0 0 6px; }
.bd-pol-aside p:last-child { margin-bottom: 0; }

/* --- the three kinds --- */
.bd-pol-kinds { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 16px; margin-top: 20px; }
.bd-pol-kind { background: #FFFFFF; border: 1px solid var(--bd-oyster); border-radius: 4px; padding: 22px 22px 24px; }
.bd-pol-kind-title { font-family: 'Roboto Condensed', sans-serif; font-size: 20px; color: #3F4042; margin: 0 0 8px; }
.bd-pol-kind-status {
  font-family: 'Roboto Condensed', sans-serif; font-weight: 700;
  font-size: 12px; letter-spacing: .09em; text-transform: uppercase; color: #57585C; margin: 0 0 10px;
}
.bd-pol-kind-body { font-size: 15px; line-height: 1.6; color: #494A4D; margin: 0; }

/* --- cookie tables, rebuilt as labelled records --- */
.bd-pol-tg {
  font-family: 'Roboto Condensed', sans-serif; font-weight: 700;
  font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: #57585C;
  margin: 32px 0 4px;
}
.bd-pol-row {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 14px 24px; padding: 18px 0; border-bottom: 1px solid var(--bd-oyster);
}
.bd-pol-cell--wide { grid-column: span 2; }
.bd-pol-micro {
  display: block;
  font-family: 'Roboto Condensed', sans-serif; font-weight: 700;
  font-size: 11px; letter-spacing: .09em; text-transform: uppercase; color: #57585C;
  margin-bottom: 4px;
}
.bd-pol-val { display: block; font-size: 15px; line-height: 1.5; color: #494A4D; }

/* --- questions card --- */
.bd-pol-qcard {
  background: #FFFFFF; border: 1px solid var(--bd-oyster); border-radius: 4px;
  padding: 32px 34px; margin-top: 52px;
}
.bd-pol-h2--card { margin-top: 0; }

@media (max-width: 749px) {
  .bd-pol { --bd-gutter: 20px; }
  .bd-pol-head { padding-block: 44px 32px; }
  .bd-pol-h1 { font-size: 32px; }
  .bd-pol-body { grid-template-columns: 1fr; gap: 28px; padding-block: 32px 56px; }
  .bd-pol-rail { position: static; }
  .bd-pol-rail-label { cursor: pointer; }
  .bd-pol-main { max-width: none; }
  .bd-pol-h2 { font-size: 26px; }
  /* rows stack into labelled records - each cell keeps its own label */
  .bd-pol-row { grid-template-columns: 1fr; gap: 12px; }
  .bd-pol-cell--wide { grid-column: auto; }
  .bd-pol-qcard { padding: 24px 22px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Policy page",
  "tag": "section",
  "class": "shopify-section--bd-policy",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "narrow", "label": "Narrow" },
        { "value": "normal", "label": "Normal" },
        { "value": "wide", "label": "Wide" },
        { "value": "content", "label": "Content width" }
      ],
      "default": "normal"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Terms and policies" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Cookie policy" },
    { "type": "text", "id": "last_updated", "label": "Last updated", "default": "Last updated 11 August 2026" },
    { "type": "text", "id": "contents_label", "label": "Contents heading", "default": "Contents" },
    { "type": "text", "id": "settings_button_label", "label": "Cookie settings button label", "default": "Cookie settings" },
    { "type": "text", "id": "settings_trigger_selector", "label": "Cookie settings trigger selector", "info": "Leave blank and the button stays hidden. Pandectes exposes no scriptable open-preferences method, so switch ON \"custom trigger\" in the Pandectes app, then paste its CSS selector here (e.g. #pandectes-trigger). The floating widget at bottom left works regardless." },
    { "type": "header", "content": "Cookie table column labels" },
    { "type": "text", "id": "label_cookie", "label": "Cookie", "default": "Cookie" },
    { "type": "text", "id": "label_set_by", "label": "Set by", "default": "Set by" },
    { "type": "text", "id": "label_purpose", "label": "Purpose", "default": "Purpose" },
    { "type": "text", "id": "label_lasts", "label": "Lasts", "default": "Lasts" }
  ],
  "blocks": [
    {
      "type": "section",
      "name": "Section",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "body", "label": "Body" },
        { "type": "richtext", "id": "aside", "label": "Aside", "info": "Quiet note set off by a left rule, e.g. company identifiers." }
      ]
    },
    {
      "type": "kind_card",
      "name": "Kind card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "status", "label": "Status", "info": "e.g. Always on, or Only with your consent." },
        { "type": "textarea", "id": "body", "label": "Body" }
      ]
    },
    {
      "type": "table_group",
      "name": "Cookie group heading",
      "settings": [
        { "type": "text", "id": "label", "label": "Group label" }
      ]
    },
    {
      "type": "table_row",
      "name": "Cookie row",
      "settings": [
        { "type": "text", "id": "cookie", "label": "Cookie" },
        { "type": "text", "id": "set_by", "label": "Set by" },
        { "type": "textarea", "id": "purpose", "label": "Purpose" },
        { "type": "text", "id": "lasts", "label": "Lasts" }
      ]
    },
    {
      "type": "questions_card",
      "name": "Questions card",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Questions" },
        { "type": "richtext", "id": "body", "label": "Body" }
      ]
    }
  ],
  "presets": [{ "name": "Policy page" }]
}
{% endschema %}
