{%- comment -%}
  sections/footer-main.liquid
  Redesigned footer: 8-icon ethos row, logo + tagline column, 3 link columns.
  Design ref: Biotaderm Home Page v2 handoff, footer spec.
{%- endcomment -%}

<div class="bd-ft" data-bd-ft>
  <div class="bd-ft-ethos">
    {%- for block in section.blocks -%}
      {%- if block.type == 'ethos_icon' -%}
        <div class="bd-ft-ethos-item" {{ block.shopify_attributes }}>
          <img src="{{ block.settings.icon | asset_url }}" alt="" class="bd-ft-ethos-icon" width="22" height="22" loading="lazy">
          <span class="bd-ft-ethos-label">{{ block.settings.label }}</span>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="bd-ft-main">
    <div class="bd-ft-brand">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 300 | image_tag: loading: 'lazy', alt: shop.name, class: 'bd-ft-logo' }}
      {%- else -%}
        <span class="bd-ft-logo-text">{{ shop.name }}</span>
      {%- endif -%}
      {%- if section.settings.tagline != blank -%}<p class="bd-ft-tagline">{{ section.settings.tagline }}</p>{%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- if block.type == 'link_column' -%}
        <div class="bd-ft-col" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}<p class="bd-ft-col-heading">{{ block.settings.heading }}</p>{%- endif -%}
          {%- if block.settings.menu != blank -%}
            <ul class="bd-ft-col-list">
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
/* ---------------------------------------------------------------------------
   GLOBAL RULE - deliberately hosted here, not in a stock Horizon file.

   Horizon's stock snippets/section.liquid renders class "section--<width>" from
   the section_width setting. The "Content width" option we add to
   sections/section.liquid therefore emits .section--page-width-content, which
   stock CSS does not define. Rather than patch stock Liquid (which theme
   updates silently revert - see CUSTOMISATIONS.md), we define it here.

   This section renders in the footer group on every page, and Shopify bundles
   {% stylesheet %} content into the theme stylesheet, so the rule is global.
   Values mirror .page-width-content in assets/base.css exactly - keep in sync
   if Horizon changes them.
   --------------------------------------------------------------------------- */
.section--page-width-content {
  --page-margin: 16px;
  --page-content-width: var(--normal-content-width);
  --page-width: calc(var(--page-content-width) + (var(--page-margin) * 2));
}
@media screen and (min-width: 750px) {
  .section--page-width-content { --page-margin: 40px; }
}

.bd-ft { background: #ffffff; border-top: 1px solid #E0E1E2; }
.bd-ft-ethos {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 32px;
  padding: 32px 80px;
  border-bottom: 1px solid #E0E1E2;
  background: #FAF7F5;
}
.bd-ft-ethos-item { display: flex; align-items: center; gap: 9px; }
.bd-ft-ethos-icon { width: 22px; height: 22px; flex-shrink: 0; display: block; }
.bd-ft-ethos-label { font-size: 12.5px; line-height: 1.3; color: #494A4D; max-width: 130px; }

.bd-ft-main {
  display: grid;
  grid-template-columns: 1.3fr 1fr 1fr 1fr;
  gap: 40px;
  padding: 64px 80px 48px;
  max-width: 1280px;
  margin: 0 auto;
}
.bd-ft-brand { display: flex; flex-direction: column; }
.bd-ft-logo { height: 52px; width: auto; object-fit: contain; object-position: left; margin-bottom: 16px; }
.bd-ft-logo-text {
  font-family: 'Roboto Condensed', sans-serif;
  font-size: 22px;
  color: #3F4042;
  margin-bottom: 16px;
  display: block;
}
.bd-ft-tagline { font-size: 14px; line-height: 1.6; color: #57585C; max-width: 260px; margin: 0; }

.bd-ft-col-heading {
  font-family: 'Roboto Condensed', sans-serif;
  font-weight: 700;
  font-size: 13px;
  letter-spacing: .06em;
  text-transform: uppercase;
  color: #3F4042;
  margin: 0 0 16px;
}
.bd-ft-col-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
.bd-ft-col-list a { font-size: 14.5px; color: #57585C; text-decoration: none; }
.bd-ft-col-list a:hover { color: #6BBBCC; }

@media (max-width: 989px) {
  .bd-ft-main { grid-template-columns: 1fr 1fr; row-gap: 36px; padding: 48px 40px 32px; }
}
@media (max-width: 749px) {
  .bd-ft-ethos { padding: 24px 20px; gap: 20px; }
  .bd-ft-ethos-label { max-width: 110px; }
  .bd-ft-main { grid-template-columns: 1fr; padding: 40px 20px 24px; gap: 28px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Footer main",
  "tag": "section",
  "class": "shopify-section--bd-footer-main",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline (under logo)",
      "default": "Honest skincare, formulated in Devon and published in full."
    }
  ],
  "blocks": [
    {
      "type": "ethos_icon",
      "name": "Ethos icon",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "ethos-microbiome.svg", "label": "Microbiome" },
            { "value": "ethos-gentle.svg", "label": "Gentle" },
            { "value": "ethos-climate.svg", "label": "Climate" },
            { "value": "ethos-formulation.svg", "label": "Formulation" },
            { "value": "ethos-cruelty.svg", "label": "Cruelty free" },
            { "value": "ethos-science.svg", "label": "Science" },
            { "value": "ethos-business.svg", "label": "Business" },
            { "value": "ethos-natural.svg", "label": "Natural" }
          ],
          "default": "ethos-gentle.svg"
        },
        { "type": "text", "id": "label", "label": "Label" }
      ]
    },
    {
      "type": "link_column",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Column heading" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer main",
      "blocks": [
        { "type": "ethos_icon", "settings": { "icon": "ethos-microbiome.svg", "label": "Made for your microbiome" } },
        { "type": "ethos_icon", "settings": { "icon": "ethos-gentle.svg", "label": "Gentle on skin, every time" } },
        { "type": "ethos_icon", "settings": { "icon": "ethos-climate.svg", "label": "Refillable and recyclable aluminium bottles, reusable pump" } },
        { "type": "ethos_icon", "settings": { "icon": "ethos-formulation.svg", "label": "Every formulation published in full" } },
        { "type": "ethos_icon", "settings": { "icon": "ethos-cruelty.svg", "label": "Vegan and cruelty-free" } },
        { "type": "ethos_icon", "settings": { "icon": "ethos-science.svg", "label": "Science-led" } },
        { "type": "ethos_icon", "settings": { "icon": "ethos-business.svg", "label": "Independent, Devon-based business" } },
        { "type": "ethos_icon", "settings": { "icon": "ethos-natural.svg", "label": "Naturally derived active ingredients" } },
        { "type": "link_column", "settings": { "heading": "Shop" } },
        { "type": "link_column", "settings": { "heading": "Support" } },
        { "type": "link_column", "settings": { "heading": "Company" } }
      ]
    }
  ]
}
{% endschema %}
