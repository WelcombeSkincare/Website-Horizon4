{%- comment -%}
  sections/contact-page.liquid  —  /pages/contact

  This section owns the WHOLE page: hero band, channel cards, form, notes
  sidebar, registered address and locator. It replaces the previous split
  across main-page + contact-channels + a `section` holding the contact-form
  block. That split is why the design could not be built: the form and the
  notes sidebar are one two-column grid, and two Liquid sections cannot share
  a grid.

  The form here is Shopify's real {% raw %}{% form 'contact' %}{% endraw %} with the same field
  names the theme's contact-form block uses (contact[name], contact[email],
  contact[phone], contact[body]) plus contact[Order number], which arrives as
  a labelled line in the notification email. Error and success handling is
  carried over from blocks/contact-form.liquid verbatim in behaviour.

  Zones, top to bottom:
    1  hero      white band, H1 + intro + portrait          (full-bleed white)
    2  channels  two tappable cards, email and phone        (on Stone)
    3  body      form card + notes sidebar, one grid        (on Stone)
    4  foot      registered address + locator               (on Stone)
{%- endcomment -%}

{%- assign sw = section.settings.section_width | default: 'normal' -%}
{%- assign form_id = 'ContactForm-' | append: section.id -%}

<div class="bd-cp page-width-{{ sw }}" data-bd-cp>

  {%- comment -%} 1 — HERO {%- endcomment -%}
  <div class="bd-cp-hero">
    <div class="bd-cp-in bd-cp-hero-grid">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="bd-cp-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h1 class="bd-cp-h1">{{ section.settings.heading | default: page.title }}</h1>
        {%- if section.settings.intro != blank -%}
          <div class="bd-cp-intro">{{ section.settings.intro }}</div>
        {%- endif -%}
      </div>
      {%- if section.settings.hero_image != blank -%}
        <div class="bd-cp-hero-img">
          {{
            section.settings.hero_image
            | image_url: width: 900
            | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(max-width: 749px) 100vw, 400px', widths: '400, 600, 900', alt: section.settings.hero_image_alt
          }}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} 2 — CHANNEL CARDS {%- endcomment -%}
  {%- assign channels = section.blocks | where: 'type', 'channel' -%}
  {%- if channels.size > 0 -%}
    <div class="bd-cp-in bd-cp-channels">
      {%- for block in channels -%}
        <a class="bd-cp-channel" href="{{ block.settings.href }}" {{ block.shopify_attributes }}>
          <span class="bd-cp-channel-label">{{ block.settings.label }}</span>
          <span class="bd-cp-channel-value">{{ block.settings.value }}</span>
          {%- if block.settings.note != blank -%}
            <span class="bd-cp-channel-note">{{ block.settings.note }}</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- comment -%} 3 — FORM + NOTES, one grid {%- endcomment -%}
  <div class="bd-cp-in bd-cp-body">

    <div class="bd-cp-formcard">
      <h2 class="bd-cp-h2">{{ section.settings.form_heading | default: 'Send a message' }}</h2>
      {%- if section.settings.form_note != blank -%}
        <p class="bd-cp-formnote">{{ section.settings.form_note }}</p>
      {%- endif -%}

      {%- form 'contact', id: form_id, class: 'bd-cp-form' -%}
        <input name="contact[id]" type="hidden" value="{{ form_id }}">

        {%- liquid
          assign form_matches = false
          if form.id == form_id or form.id == blank
            assign form_matches = true
          endif
        -%}

        {%- if form.errors and form_matches -%}
          <div class="bd-cp-form-error" tabindex="-1" autofocus>
            {{- 'icon-error.svg' | inline_asset_content -}}
            {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
          </div>
        {%- endif -%}

        {%- if form.posted_successfully? and form_matches -%}
          <div class="bd-cp-form-success" tabindex="-1" autofocus>
            {{- 'icon-checkmark.svg' | inline_asset_content -}}
            {{- 'blocks.contact_form.post_success' | t -}}
          </div>
        {%- endif -%}

        <div class="bd-cp-form-row">
          <label class="bd-cp-field" for="{{ form_id }}-name">
            <span class="bd-cp-label">Name</span>
            <input
              type="text"
              id="{{ form_id }}-name"
              class="bd-cp-input"
              autocomplete="name"
              name="contact[name]"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            >
          </label>

          <label class="bd-cp-field" for="{{ form_id }}-email">
            <span class="bd-cp-label">Email address</span>
            <input
              type="email"
              id="{{ form_id }}-email"
              class="bd-cp-input"
              autocomplete="email"
              name="contact[email]"
              spellcheck="false"
              autocapitalize="off"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              aria-required="true"
              {% if form.errors contains 'email' and form_matches %}
                aria-invalid="true"
              {% endif %}
            >
          </label>
        </div>

        <div class="bd-cp-form-row">
          <label class="bd-cp-field" for="{{ form_id }}-phone">
            <span class="bd-cp-label">Phone</span>
            <input
              type="tel"
              id="{{ form_id }}-phone"
              class="bd-cp-input"
              autocomplete="tel"
              name="contact[phone]"
              value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
            >
          </label>

          <label class="bd-cp-field" for="{{ form_id }}-order">
            <span class="bd-cp-label">Order number</span>
            <input
              type="text"
              id="{{ form_id }}-order"
              class="bd-cp-input"
              name="contact[Order number]"
              placeholder="If it is about an order"
            >
          </label>
        </div>

        <label class="bd-cp-field" for="{{ form_id }}-body">
          <span class="bd-cp-label">Message</span>
          <textarea rows="6" id="{{ form_id }}-body" class="bd-cp-input bd-cp-textarea" name="contact[body]">{{- form.body -}}</textarea>
        </label>

        <div class="bd-cp-form-actions">
          <button type="submit" class="button">{{ section.settings.submit_label | default: 'Send message' }}</button>
        </div>
      {%- endform -%}
    </div>

    {%- assign notes = section.blocks | where: 'type', 'note' -%}
    {%- if notes.size > 0 -%}
      <aside class="bd-cp-notes">
        {%- for block in notes -%}
          <div class="bd-cp-note" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3 class="bd-cp-note-h">{{ block.settings.heading }}</h3>
            {%- endif -%}
            <div class="bd-cp-note-b">{{ block.settings.body }}</div>
          </div>
        {%- endfor -%}
      </aside>
    {%- endif -%}
  </div>

  {%- comment -%} 4 — REGISTERED ADDRESS + LOCATOR {%- endcomment -%}
  {%- if section.settings.legal != blank or section.settings.map_image != blank -%}
    <div class="bd-cp-in bd-cp-foot">
      {%- if section.settings.legal != blank -%}
        <div class="bd-cp-legal">{{ section.settings.legal }}</div>
      {%- endif -%}
      {%- if section.settings.map_image != blank -%}
        <div class="bd-cp-map">
          {{ section.settings.map_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.map_alt }}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
.bd-cp {
  --bd-gutter: 80px;
  --bd-oyster: #E0E1E2;
  --bd-stone: #FAF7F5;
  background: var(--bd-stone);
  padding-block-end: 96px;
}
.bd-cp-in {
  padding-inline: max(var(--bd-gutter), calc((100% - var(--page-content-width, 120rem)) / 2));
}

/* 1 — hero: full-bleed white band inside a Stone section */
.bd-cp-hero { background: #FFFFFF; border-block-end: 1px solid var(--bd-oyster); }
.bd-cp-hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
  gap: 64px;
  align-items: center;
  padding-block: 84px 64px;
}
.bd-cp-eyebrow {
  font-family: 'Roboto Condensed', sans-serif; font-weight: 700; font-size: 12px;
  letter-spacing: .12em; text-transform: uppercase; color: #57585C; margin: 0 0 20px;
}
.bd-cp-h1 {
  font-family: 'Roboto Condensed', sans-serif; font-weight: 400; font-size: 56px;
  line-height: 1.08; color: #161617; margin: 0 0 24px; text-wrap: pretty;
}
.bd-cp-intro p {
  font-size: 20px; line-height: 1.55; color: #4B4C4F; max-width: 52ch; margin: 0 0 16px;
}
.bd-cp-intro p:last-child { margin-bottom: 0; }
.bd-cp-hero-img { aspect-ratio: 4 / 5; border-radius: 4px; overflow: hidden; background: var(--bd-stone); }
.bd-cp-hero-img img { width: 100%; height: 100%; object-fit: cover; display: block; }

/* 2 — channel cards */
.bd-cp-channels {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 20px; padding-block-start: 56px;
}
.bd-cp-channel {
  display: block; background: #FFFFFF; border: 1px solid var(--bd-oyster);
  border-radius: 4px; padding: 36px 38px; text-decoration: none;
  transition: border-color .16s ease;
}
.bd-cp-channel:hover { border-color: #57585C; }
.bd-cp-channel-label {
  display: block; font-family: 'Roboto Condensed', sans-serif; font-weight: 700;
  font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: #57585C; margin-bottom: 14px;
}
.bd-cp-channel-value {
  display: block; font-family: 'Roboto Condensed', sans-serif; font-weight: 400;
  font-size: 34px; line-height: 1.15; color: #161617; word-break: break-word; margin-bottom: 12px;
}
.bd-cp-channel-note { display: block; font-size: 16px; line-height: 1.55; color: #494A4D; }

/* 3 — form + notes, one grid */
.bd-cp-body {
  display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, 400px);
  gap: 64px; align-items: start; padding-block-start: 56px;
}
.bd-cp-formcard {
  background: #FFFFFF; border: 1px solid var(--bd-oyster);
  border-radius: 4px; padding: 40px 42px;
}
.bd-cp-h2 {
  font-family: 'Roboto Condensed', sans-serif; font-weight: 400; font-size: 32px;
  line-height: 1.1; color: #3F4042; margin: 0 0 8px;
}
.bd-cp-formnote { font-size: 16px; line-height: 1.55; color: #57585C; margin: 0 0 30px; }
.bd-cp-form { display: flex; flex-direction: column; gap: 20px; }
.bd-cp-form-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20px; }
.bd-cp-field { display: flex; flex-direction: column; gap: 8px; }
.bd-cp-label { font-size: 14px; line-height: 1.4; color: #4B4C4F; }
.bd-cp-input {
  width: 100%; font-family: inherit; font-size: 16px; padding: 12px 14px;
  color: #494A4D; background: var(--bd-stone);
  border: 1px solid var(--bd-oyster);
  border-radius: var(--style-border-radius-inputs, 4px);
}
.bd-cp-input:focus-visible { outline: 2px solid #161617; outline-offset: 1px; }
.bd-cp-textarea { resize: vertical; min-height: 160px; }
.bd-cp-form-actions { margin-top: 6px; }
.bd-cp-form-error,
.bd-cp-form-success { display: flex; align-items: center; gap: 8px; font-size: 15px; }

.bd-cp-notes { display: flex; flex-direction: column; gap: 36px; }
.bd-cp-note + .bd-cp-note { border-block-start: 1px solid var(--bd-oyster); padding-block-start: 30px; }
.bd-cp-note-h {
  font-family: 'Roboto Condensed', sans-serif; font-weight: 400; font-size: 24px;
  color: #414245; margin: 0 0 10px;
}
.bd-cp-note-b p { font-size: 16px; line-height: 1.6; color: #494A4D; margin: 0 0 10px; }
.bd-cp-note-b p:last-child { margin-bottom: 0; }
.bd-cp-note-b a { color: #161617; text-decoration: underline; }

/* 4 — foot */
.bd-cp-foot {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 32px; align-items: center;
  margin-block-start: 64px; border-block-start: 1px solid var(--bd-oyster); padding-block-start: 26px;
}
.bd-cp-legal p { font-size: 13px; line-height: 1.7; color: #57585C; margin: 0; }
.bd-cp-legal strong { font-weight: 500; color: #4B4C4F; }
.bd-cp-map { aspect-ratio: 4 / 3; border: 1px solid var(--bd-oyster); border-radius: 4px; overflow: hidden; background: #FFFFFF; }
.bd-cp-map img { width: 100%; height: 100%; object-fit: cover; display: block; }

@media (max-width: 749px) {
  .bd-cp { --bd-gutter: 20px; padding-block-end: 56px; }
  .bd-cp-hero-grid { grid-template-columns: 1fr; gap: 32px; padding-block: 48px 40px; }
  .bd-cp-h1 { font-size: 38px; }
  .bd-cp-intro p { font-size: 18px; }
  .bd-cp-channels { padding-block-start: 32px; }
  .bd-cp-channel { padding: 26px 22px; }
  .bd-cp-channel-value { font-size: 26px; }
  .bd-cp-body { grid-template-columns: 1fr; gap: 40px; padding-block-start: 32px; }
  .bd-cp-formcard { padding: 28px 22px; }
  .bd-cp-form-row { grid-template-columns: 1fr; }
  .bd-cp-foot { margin-block-start: 40px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Contact page",
  "tag": "section",
  "class": "shopify-section--bd-contact",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "narrow", "label": "Narrow" },
        { "value": "normal", "label": "Normal" },
        { "value": "wide", "label": "Wide" },
        { "value": "content", "label": "Content width" }
      ],
      "default": "normal"
    },
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Renders as the page H1. Falls back to the page title." },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image", "info": "4:5 portrait. Richard at the bench — hands filling or capping. Craft, never research: no white coats, no microscopes." },
    { "type": "text", "id": "hero_image_alt", "label": "Hero image alt text" },
    { "type": "header", "content": "Form" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Send a message" },
    { "type": "text", "id": "form_note", "label": "Form note", "default": "It goes to the same inbox. Only the email address is required." },
    { "type": "text", "id": "submit_label", "label": "Submit button label", "default": "Send message" },
    { "type": "header", "content": "Foot" },
    { "type": "richtext", "id": "legal", "label": "Registered address" },
    { "type": "image_picker", "id": "map_image", "label": "Locator image", "info": "A static map or a committed SVG. Do not pull a mapping library into the theme for one decorative locator." },
    { "type": "text", "id": "map_alt", "label": "Locator alt text", "info": "Leave blank if the address beside it already says it — the image is then decorative." }
  ],
  "blocks": [
    {
      "type": "channel",
      "name": "Channel card",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "value", "label": "Value" },
        { "type": "text", "id": "href", "label": "Link", "info": "mailto: or tel:" },
        { "type": "textarea", "id": "note", "label": "Note" }
      ]
    },
    {
      "type": "note",
      "name": "Note",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "body", "label": "Body" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact page",
      "settings": {
        "eyebrow": "Welcombe, north Devon",
        "heading": "Contact",
        "intro": "<p>Everything here is made by hand by one person, so the person answering this email is the person who made your moisturiser. That has an obvious drawback, which is that I am sometimes in the workshop rather than at the desk. It also means nobody is going to read you a script.</p>",
        "form_heading": "Send a message",
        "form_note": "It goes to the same inbox. Only the email address is required.",
        "submit_label": "Send message",
        "legal": "<p><strong>Welcombe Skincare Ltd</strong>, trading as Biotaderm<br>Darracott Farm, Welcombe, Devon EX39 6HG, United Kingdom<br>Registered in England and Wales, company number 13451607</p>"
      },
      "blocks": [
        {
          "type": "channel",
          "settings": {
            "label": "Email",
            "value": "store@biotaderm.com",
            "href": "mailto:store@biotaderm.com",
            "note": "I answer emails within one working day, usually the same day."
          }
        },
        {
          "type": "channel",
          "settings": {
            "label": "Phone",
            "value": "01288 272800",
            "href": "tel:+441288272800",
            "note": "Better for anything urgent, though if it rings out it is because both hands are in a batch."
          }
        },
        {
          "type": "note",
          "settings": {
            "heading": "What to include",
            "body": "<p>If it is about an order, the order number saves us a round trip. If it is about your skin, tell me what it is doing and what you have tried, and I will give you a straight answer even when the straight answer is that we do not make the thing you need.</p>"
          }
        },
        {
          "type": "note",
          "settings": {
            "heading": "Returns and the Two-Week Trial",
            "body": "<p>If a product has not suited you, email and say so. You do not need to explain yourself, and you do not need to send a full bottle back. Everything you are entitled to is set out in our <a href=\"/policies/refund-policy\">returns policy</a>, including the 14-day statutory right to cancel and our extended 60-day return period.</p>"
          }
        },
        {
          "type": "note",
          "settings": {
            "heading": "Privacy",
            "body": "<p>Anything you send goes to me and nowhere else. What happens to it is in our <a href=\"/policies/privacy-policy\">privacy policy</a>.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
