{%- comment -%}
  sections/home-newsletter.liquid
  Marketing list signup band, low on the home page (design handoff section 12).

  This block must NOT promise a discount for signing up. The Opening Offer is
  earned by ordering before 30 September 2026, never by joining a list - a
  customer who signs up and then gets nothing at checkout has been misled.
  No percentage, no code, no welcome discount. See HO-02.

  Uses Shopify's native customer form, so it posts to the customer list the same
  way the footer form does. The success message confirms only that the address
  is saved; it must not promise an email will arrive, because the sending domain
  is unverified and the Omnisend flows are off.

  The field label is a real <label>, not a placeholder, per design section 12.
{%- endcomment -%}

<div class="bd-nl page-width-{{ section.settings.section_width | default: 'normal' }}" id="signup" data-bd-nl>
  <div class="bd-nl-copy">
    {%- if section.settings.eyebrow != blank -%}<p class="bd-nl-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="bd-nl-h2">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.body != blank -%}<div class="bd-nl-body">{{ section.settings.body }}</div>{%- endif -%}
    {%- if section.settings.small_print != blank -%}<p class="bd-nl-small">{{ section.settings.small_print }}</p>{%- endif -%}
  </div>

  <div class="bd-nl-form-wrap">
    {%- form 'customer', id: 'bd-nl-form', class: 'bd-nl-form' -%}
      <input type="hidden" name="contact[tags]" value="{{ section.settings.customer_tags | default: 'newsletter' }}">
      {%- if form.posted_successfully? -%}
        <p class="bd-nl-success">{{ section.settings.success_message | default: 'Thank you. We have your address.' }}</p>
      {%- else -%}
        {%- if form.errors -%}
          <p class="bd-nl-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
        {%- if section.settings.field_label != blank -%}
          <label class="bd-nl-label" for="bd-nl-email">{{ section.settings.field_label }}</label>
        {%- endif -%}
        <div class="bd-nl-row">
          <input type="email" id="bd-nl-email" name="contact[email]" class="bd-nl-input" autocomplete="email" required>
          <button type="submit" class="bd-nl-btn">{{ section.settings.button_label | default: 'Sign up' }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% stylesheet %}
.bd-nl {
  /* Was a centred 1180px box; now a full-bleed band with the content centred to
     the chosen width, so it matches the other home sections. */
  --bd-gutter: 80px;
  padding-block: 88px;
  padding-inline: max(var(--bd-gutter), calc((100% - var(--page-content-width, 120rem)) / 2));
  background: #FBFBF2;
  border-top: 1px solid #E0E1E2;
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 72px;
  align-items: center;
}
.bd-nl-eyebrow {
  font-size: 12px;
  letter-spacing: .14em;
  text-transform: uppercase;
  font-weight: 700;
  color: #4E6D6C;
  margin: 0 0 10px;
}
.bd-nl-h2 {
  font-family: 'Roboto Condensed', sans-serif;
  font-weight: 400;
  font-size: 40px;
  color: #3F4042;
  margin: 0 0 16px;
}
.bd-nl-body { font-size: 17px; line-height: 1.65; max-width: 560px; color: #494A4D; margin-bottom: 12px; }
.bd-nl-body p { margin: 0; }
.bd-nl-small { font-size: 15px; line-height: 1.6; color: #57585C; margin: 8px 0 0; }
.bd-nl-small a { color: #4E6D6C; text-decoration: underline; }
.bd-nl-small a:hover { color: #F47D5E; }
.bd-nl-label {
  display: block;
  font-family: 'Roboto Condensed', sans-serif;
  font-weight: 700;
  font-size: 12px;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: #4E6D6C;
  margin: 0 0 8px;
}
.bd-nl-row { display: flex; gap: 10px; align-items: stretch; }
.bd-nl-input {
  flex: 1;
  padding: 14px 16px;
  font-size: 15px;
  border: 1px solid #E0E1E2;
  border-radius: 4px;
  background: #fff;
  box-sizing: border-box;
}
.bd-nl-btn {
  font-family: 'Roboto Condensed', sans-serif;
  font-weight: 700;
  font-size: 15px;
  background: #6BBBCC;
  color: #161617;
  border: 2px solid #6BBBCC;
  border-radius: 14px;
  padding: 0 26px;
  cursor: pointer;
  white-space: nowrap;
  transition: background-color .16s ease, border-color .16s ease;
}
.bd-nl-btn:hover { background: #F47D5E; border-color: #F47D5E; }
.bd-nl-success { font-size: 16px; color: #4E6D6C; margin: 0; }
.bd-nl-error { font-size: 14px; color: #963C3D; margin: 0 0 10px; }

@media (max-width: 749px) {
  .bd-nl { grid-template-columns: 1fr; --bd-gutter: 20px; padding-block: 40px; gap: 28px; }
  .bd-nl-h2 { font-size: 30px; }
  .bd-nl-row { flex-direction: column; }
  .bd-nl-btn { padding: 13px 26px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Home newsletter / club",
  "tag": "section",
  "class": "shopify-section--bd-home-newsletter",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "narrow", "label": "Narrow" },
        { "value": "normal", "label": "Normal" },
        { "value": "wide", "label": "Wide" },
        { "value": "content", "label": "Content width" }
      ],
      "default": "normal"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Leave blank. The approved design for this band has no eyebrow."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hear from us now and then"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "info": "Must not promise a discount, a code or a percentage for signing up. The Opening Offer is earned by ordering, never by joining a list.",
      "default": "<p>New formulations, what we are making, and the occasional offer. One click gets you out again.</p>"
    },
    {
      "type": "text",
      "id": "field_label",
      "label": "Field label",
      "info": "Shown as a visible label above the input, not as a placeholder.",
      "default": "Email address"
    },
    {
      "type": "inline_richtext",
      "id": "small_print",
      "label": "Small print",
      "info": "Accepts a link, e.g. to the privacy policy.",
      "default": "We will not pass your address to anyone. You can unsubscribe from any email. See our <a href=\"/policies/privacy-policy\">privacy policy</a>."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Sign up"
    },
    {
      "type": "text",
      "id": "customer_tags",
      "label": "Customer tags to apply on signup",
      "info": "Comma-separated. This only tags the customer record.",
      "default": "newsletter"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "info": "Confirm only that the address is saved. Do not promise an email will arrive - the sending domain is unverified and the flows are off.",
      "default": "Thank you. We have your address."
    }
  ],
  "presets": [
    { "name": "Home newsletter / club" }
  ]
}
{% endschema %}
