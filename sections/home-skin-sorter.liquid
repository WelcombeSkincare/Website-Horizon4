          "type": "tile",
          "settings": {
            "index": "05",
            "title": "Oily Sensitive",
            "description": "Oilier skin that still reacts easily, and wants lightness with care.",
            "bg_color": "#A37594",
            "text_color": "#ffffff"
          }
