    "home_itb_microbiome": {
      "type": "home-image-text-band",
      "settings": {
        "image_position": "left",
        "heading": "Made for your microbiome",
        "body": "<p>Your skin is a living surface with its own microbiome, the community of microbes that helps keep it healthy. The research points steadily in one direction. Skin tends to do better when that community is supported rather than stripped. So we formulate to nourish it, with prebiotics, postbiotics and cold-pressed oils, and we leave synthetic fragrance out entirely.</p>",
        "link_label": "Read the science",
        "standin_asset": "home-microbiome-standin.jpg"
      }
    },
    "home_itb_why_started": {
      "type": "home-image-text-band",
      "settings": {
        "image_position": "right",
        "heading": "Why we started",
        "body": "<p>Biotaderm began on the north Devon coast with a simple frustration: skincare labels that told you almost nothing. We set out to make the opposite. Every formulation published in full, every percentage listed, nothing hidden behind a marketing name.</p>",
        "link_label": "Read our story",
        "standin_asset": "home-why-started-standin.jpg"
      }
    },
    "home_ethos_strip": {
      "type": "home-ethos-strip",
      "blocks": {
        "ethos_gentle": { "type": "ethos", "settings": { "icon": "ethos-gentle.svg", "label": "Made by hand in Welcombe, Devon" } },
        "ethos_cruelty": { "type": "ethos", "settings": { "icon": "ethos-cruelty.svg", "label": "Vegan and cruelty-free" } },
        "ethos_climate": { "type": "ethos", "settings": { "icon": "ethos-climate.svg", "label": "Aluminium packaging, widely recycled" } },
        "ethos_formulation": { "type": "ethos", "settings": { "icon": "ethos-formulation.svg", "label": "Every formulation published in full" } }
      },
      "block_order": ["ethos_gentle", "ethos_cruelty", "ethos_climate", "ethos_formulation"],
      "settings": {}
    },
